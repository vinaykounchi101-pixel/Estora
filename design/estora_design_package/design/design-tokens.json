{
  "brand": "Estora",
  "description": "Real Estate Intelligence Platform",
  "themes": {
    "light": {
      "color": {
        "background": "#F2F2F2",
        "surface": "#FEFDFC",
        "text": "#0F0F09",
        "textMuted": "#585E5F",
        "sage": "#C4CEB8",
        "stone": "#585E5F",
        "earth": "#453F22",
        "slate": "#9EA9B2",
        "taupe": "#8D7658",
