  "typography": {
    "display": {
      "fontFamily": "Playfair Display",
      "usage": "Hero and editorial headlines"
    },
    "body": {
      "fontFamily": "Inter",
      "usage": "Navigation, forms, tables, charts and body text"
    },
    "scalePx": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "5xl": 48,
      "hero": 64
    }
  },
  "spacingPx": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radiusPx": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15,15,9,0.05)",
    "md": "0 4px 16px rgba(15,15,9,0.07)",
    "lg": "0 12px 32px rgba(15,15,9,0.10)"
  },
  "motion": {
    "fastMs": 140,
    "normalMs": 220,
    "slowMs": 360,
    "easing": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "rules": [
      "Use restrained entrance and scroll reveals.",
      "Respect prefers-reduced-motion.",
      "Never delay form submission or navigation for animation.",
      "Animate semantic theme colors without flashing."
    ]
  },
  "layout": {
    "contentMaxWidthPx": 1440,
    "readingMaxWidthPx": 760,
    "pageGutterPx": {
      "mobile": 20,
      "tablet": 32,
      "desktop": 56
    },
    "sidebarWidthPx": 248,
    "headerHeightPx": 76
  },
  "principles": [
    "Light editorial theme is the default; dark theme is user-selectable.",
    "Architectural hero imagery blends into the background using a theme-aware gradient mask.",
    "Do not hardcode runtime business data, property listings, statistics, user records, or prediction outputs.",
    "Use semantic tokens in components rather than raw hex values.",
    "Verify WCAG AA contrast for text and interactive controls."
  ]
}