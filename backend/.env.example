# Backend Environment Variables
PROJECT_NAME=Estora
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Connection Credentials
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=estora

# Optional direct connection URL override (e.g. for hosted databases or SQLite testing)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/estora

# Connection Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# Security & Services
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ML_ARTIFACTS_DIR=../../ml/artifacts

# Administrative Account Seed (Environment-variable driven)
ADMIN_EMAIL=admin@estora.internal
ADMIN_PASSWORD=AdminEstora2026!
ADMIN_NAME=Estora System Administrator

